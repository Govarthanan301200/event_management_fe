# Copy to .env (or .env.local) and fill in. Only VITE_* values reach the browser and they are public.
# Base URL of the backend API (Northflank public URL in production)
VITE_API_URL=http://localhost:4000
VITE_APP_ENV=development
# Supabase Auth for planner sign-in (Project Settings → API). The publishable/anon key is public by design.
# Leave empty to run only the public client form.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
